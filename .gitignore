# nerima-lisp standard .gitignore
# Copy to <repo>/.gitignore and append repository-specific entries below the
# marked section. Everything above the marker must stay identical across repos
# so that "is this artifact ignored?" has the same answer everywhere.

# --- Common Lisp build output ---
*.fasl
*.fas
*.lib
*.dfsl
*.ufsl
*.fsl

# --- Nix ---
/result
/result-*
/.direnv/

# --- Test and coverage output ---
/coverage/
/coverage-report/
/*-coverage-report/
*.coverage
coverage.dat
/__snapshots__/
/*-snapshots/

# --- Local caches and scratch space ---
/.cache/
/.deps/
/tmp/
/.worktrees/
/.paredit.cleanup/

# --- Credentials ---
# Not because anyone plans to put a key here, but because the cost of the one
# time it happens by accident is a rotation across the whole org. See
# SUPPLY_CHAIN.md for what to do if one is committed anyway.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
/secrets/

# --- Editor and OS noise ---
.DS_Store
*~
\#*\#
.\#*

# --- Repository-specific entries below this line ---

# Compiled cl-cc binary produced by `nix build` and copied out of ./result.
/cl-cc

# SBCL core images.
*.core
*.lx64fsl
*.dx64fsl
a.out

# cl-weave snapshot file locks (transient, created while writing snapshots).
*.sexp.lock

# Test timing ledgers written by the test runner.
test-timings.tsv
cl-cc-timings-override-for-test.tsv

# Agent and tooling scratch space.
/.claude/
/.playwright-mcp/
