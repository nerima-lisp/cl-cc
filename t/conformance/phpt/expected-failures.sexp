;;;; Expected functional PHPT failures from the pinned PHP conformance run.
;;;; Harness errors are recorded separately in harness-errors.tsv.
;;;; Group entries only when classification, stage, reason, and observed diagnostic match.
;;;;
;;;; Each entry is (:cases ("path/to/test.phpt" ...) :classification :bug|:unimplemented|
;;;;   :implementation-defined :reason "evidence" :match "observed diagnostic regex" :stage :compile|:runtime|:output).
;;;; Individual :bug compile-timeout entries may use :allow-pass t only with an issue and observed run IDs.
(
  (:cases (
    "ext/date/tests/strtotime-mysql-64bit.phpt"
   ) :classification :bug
      :reason ":bug: array append is implemented, but the first $d[] assignment does not initialize/bind an undefined array before foreach; parser-expr-operator.lisp:280-286 passes it directly to %php-array-push."
      :match "^compile\\ error:\\ Compilation\\ failed:"
      :stage :compile)
  (:cases (
    "ext/date/tests/bug32086.phpt"
   ) :classification :bug
      :reason ":bug: assignment is implemented and echo threads known variables, but this later echo argument still loses $l; parser-expr-operator.lisp:251-279 and parser-stmt-decls-control.lisp:7-22."
      :match "^compile\\ error:\\ Compilation\\ failed:"
      :stage :compile)
  (:cases (
    "ext/reflection/tests/ReflectionParameter_getDocComment_property_hooks.phpt"
   ) :classification :bug
      :reason "A PHP 8.4 property-hook declaration in a promoted constructor parameter is rejected even though property hooks and property promotion are supported. Evidence: cl-cc-php source/docs/src/reference/compatibility.md:8-20; cl-cc-php source/src/parser-property-hooks.lisp:47-80; cl-cc-php source/src/parser-stmt-params.lisp:89-116. W4-04 taxonomy: W4-04 spec.md §2.3 (lines 67-74)."
      :match "^compile error: PHP parse error: expected :T-RPAREN but got"
      :stage :compile)
  (:cases (
    "ext/reflection/tests/abstract_property_indicated.phpt"
    "ext/reflection/tests/property_hooks/basics.phpt"
   ) :classification :bug
      :reason "A valid PHP 8.4 property-hook declaration reaches a parser rejection despite property hooks being an explicitly supported feature. Evidence: cl-cc-php source/docs/src/reference/compatibility.md:8-20; cl-cc-php source/src/parser-property-hooks.lisp:47-80. W4-04 taxonomy: W4-04 spec.md §2.3 (lines 67-74)."
      :match "^compile error: PHP 8\\.4 property hook error: expected => or \\{ after hook name"
      :stage :compile)
